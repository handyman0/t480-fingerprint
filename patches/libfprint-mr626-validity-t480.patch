+/* Local patch: LIBFPRINT_VALIDITY_DATA_DIR names an extra directory that is
+ * searched BEFORE the system paths. The default behaviour is unchanged when
+ * the variable is unset. To keep it safe for a privileged process the
+ * directory must be absolute, resolve (symlinks included) to a directory
+ * owned by the effective user and not writable by group/others, and the
+ * variable is ignored in setuid/setgid contexts (secure_getenv). The files
+ * are still HMAC-checked, but that key is public: this protects against
+ * corruption, not against a hostile directory, hence the ownership rules. */
+static void
+validity_data_apply_env_dir (void)
+{
+  static gboolean done = FALSE;
+  const char *env;
+  char *real;
+  struct stat st;
+
+  if (done)
+    return;
+  done = TRUE;
+
+  env = secure_getenv ("LIBFPRINT_VALIDITY_DATA_DIR");
+  if (env == NULL || env[0] == '\0')
+    return;
+
+  if (env[0] != '/')
+    {
+      fp_warn ("LIBFPRINT_VALIDITY_DATA_DIR must be an absolute path; ignored");
+      return;
+    }
+
+  real = realpath (env, NULL);
+  if (real == NULL || stat (real, &st) != 0 || !S_ISDIR (st.st_mode) ||
+      st.st_uid != geteuid () || (st.st_mode & (S_IWGRP | S_IWOTH)) != 0)
+    {
+      fp_warn ("LIBFPRINT_VALIDITY_DATA_DIR '%s' rejected (must be a directory "
+               "owned by the current user and not group/other-writable); ignored",
+               env);
+      free (real);
+      return;
+    }
+
+  /* Shift [sys, local, NULL] -> [private, sys, local, NULL] */
+  if (validity_data_search_paths[2] != NULL)
+    {
+      fp_warn ("validity data search path table is full; private dir ignored");
+      free (real);
+      return;
+    }
+  validity_data_search_paths[3] = NULL;
+  validity_data_search_paths[2] = validity_data_search_paths[1];
+  validity_data_search_paths[1] = validity_data_search_paths[0];
+  validity_data_search_paths[0] = real;   /* intentionally never freed */
+  fp_info ("Using private validity data directory %s", real);
+}
+
